<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>matterdesk</AssemblyName>
    <RootNamespace>MatterDesk.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Not trimmed: the client serialises anonymous types through reflection, and the solution builds with -warnaserror. -->
    <Version>0.1.0</Version>
    <Authors>Luis Escobar</Authors>
    <Description>MatterDesk local client: REST walkthrough against the hosted API, and a stdio MCP bridge for AI clients.</Description>
  </PropertyGroup>

</Project>
